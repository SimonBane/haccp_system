{
  "name": "@haccp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file=.env.local src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --env-file=.env.local dist/index.js",
    "start:ci": "node dist/index.js",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "db:generate": "node --env-file=.env --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:check": "drizzle-kit generate",
    "db:studio": "node --env-file=.env --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "repair:role-projection": "tsx --env-file=.env --env-file=.env.local scripts/repair-role-projection.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.2",
    "@haccp/shared": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "@hono/zod-openapi": "^1.5.1",
    "@sentry/hono": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.11",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@haccp/eslint-config": "workspace:*",
    "@haccp/typescript-config": "workspace:*",
    "@haccp/vitest-config": "workspace:*",
    "@hono/swagger-ui": "^0.6.1",
    "@types/node": "^24",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "pino-pretty": "^13.1.3",
    "standardwebhooks": "1.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
