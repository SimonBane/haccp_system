API_PORT=3001
# Comma-separated list of allowed web app origins
CORS_ORIGIN=http://localhost:3000
# Production example:
# CORS_ORIGIN=https://haccp-system-web.vercel.app

# Supabase Postgres — haccp-api (eu-central-1)
# Dashboard: https://supabase.com/dashboard/project/ottlklibvmkdhjhrabjf
# Settings → Database → copy or reset your database password
#
# Transaction pooler (port 6543) — use for the running API
# Username: postgres.ottlklibvmkdhjhrabjf
DATABASE_URL=postgresql://postgres.ottlklibvmkdhjhrabjf:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432) — use for migrations only (drizzle-kit)
# Username: postgres (not postgres.<project-ref>)
# Use the same database password as above. URL-encode special characters.
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ottlklibvmkdhjhrabjf.supabase.co:5432/postgres

NODE_ENV=development

# Redis Cloud — used for location cache
# Dashboard: https://redis.io/cloud
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-HOST].db.redis.io:[PORT]

# Clerk — run `clerk env pull` from apps/api (writes to .env.local)
# Dev script loads .env then .env.local
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
