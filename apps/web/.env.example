NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry (Vercel Production only — do not set locally)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Clerk (from `clerk init` / `clerk env pull` — do not commit real keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# App-sent org invites use redirectUrl=/accept-invitation (see apps/api WEB_APP_URL).
# Dashboard invites land on sign-up/sign-in; the app redirects __clerk_ticket to /accept-invitation.
